#!/usr/bin/env bash
set -euo pipefail

DEFAULT_DIR="$HOME/projects/budgeat"

target_dir=""
use_here=false
status=false
worktree_pick=false
worktree_only=false
mode="both"
reuse_tab="auto" # auto|true|false
this_terminal=false
open_terminal=true

usage() {
  cat <<'USAGE'
Usage: dev-tabs [DIR] [OPTIONS]

Opens a native WezTerm dev layout for the target directory.

By default, if DIR is inside a git repo, this anchors to the repo root. Use
--here to anchor to the exact DIR instead.

You can group short flags (that take no value), e.g. `-TRw`.

Options:
  -w, --worktree       Select a git worktree interactively (requires git repo)
  -W, --worktree-only  Select a git worktree and open an interactive shell there
  -m, --mode MODE      Open panes for MODE: both|codex|standard (default: both)
  -c                   Shortcut for --mode codex
  -t                   Shortcut for --mode standard
  -b                   Shortcut for --mode both
  -T, --this-terminal  Reuse this terminal instead of opening WezTerm
  -R, --reuse-tab      Reuse the current WezTerm tab when possible
  -N, --new-tab        Always open a fresh WezTerm tab/window
  -H, --here           Anchor to DIR (not git repo root)
  -S, --status         Print computed target details and exit
  -h, --help           Show help
USAGE
}

die() {
  printf "Error: %s\n" "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

prompt_read() {
  local prompt="$1"
  local var_name="$2"
  if [[ -r /dev/tty ]]; then
    read -r -p "$prompt" "$var_name" </dev/tty || return 1
  else
    read -r -p "$prompt" "$var_name" || return 1
  fi
}

realpath_of() {
  python3 - <<'PY' "$1"
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
}

select_worktree_dir() {
  local dir="$1"
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || die "--worktree requires a git repo (DIR=$dir)"

  local entries
  entries="$(git -C "$dir" worktree list --porcelain 2>/dev/null || true)"
  [[ -n "${entries:-}" ]] || die "No git worktrees found (DIR=$dir)"

  if command -v fzf >/dev/null 2>&1; then
    local picked
    picked="$(
      printf "%s\n" "$entries" \
        | awk '
            BEGIN { p=""; b=""; d="" }
            $1=="worktree" { if (p!="") { printf "%s\t%s\n", p, (b==""?d:b) } p=$2; b=""; d="" }
            $1=="branch" { b=$2 }
            $1=="detached" { d="(detached)" }
            END { if (p!="") { printf "%s\t%s\n", p, (b==""?d:b) } }
          ' \
        | fzf --prompt="Worktree> " \
        | cut -f1
    )"
    [[ -n "${picked:-}" ]] || die "No worktree selected"
    printf "%s" "$picked"
    return 0
  fi

  local paths
  paths="$(printf "%s\n" "$entries" | awk '$1=="worktree"{print $2}')"
  [[ -n "${paths:-}" ]] || die "No git worktrees found (DIR=$dir)"

  local i=1
  printf "Worktrees:\n" >&2
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    local b
    b="$(printf "%s\n" "$entries" | awk -v want="$p" '
      $1=="worktree"{p=$2}
      $1=="branch" && p==want {print $2; exit}
      $1=="detached" && p==want {print "(detached)"; exit}
    ')"
    [[ -n "${b:-}" ]] || b="(unknown)"
    printf "  %d) %s  %s\n" "$i" "$p" "$b" >&2
    i=$((i + 1))
  done <<< "$paths"

  local pick
  prompt_read "Select worktree (1-$((i - 1))): " pick || die "Selection failed"
  [[ "$pick" =~ ^[0-9]+$ ]] || die "Invalid selection: $pick"
  (( pick >= 1 && pick < i )) || die "Out of range selection: $pick"
  printf "%s\n" "$paths" | sed -n "${pick}p"
}

anchor_dir_for() {
  local dir="$1"
  if [[ "$use_here" == "true" ]]; then
    printf "%s" "$dir"
    return 0
  fi
  if git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$dir" rev-parse --show-toplevel
    return 0
  fi
  printf "%s" "$dir"
}

inside_wezterm() {
  [[ -n "${WEZTERM_PANE:-}" || "${TERM_PROGRAM:-}" == "WezTerm" ]]
}

build_profile_command() {
  local profile="$1"
  local dir="$2"
  local shell_path="$3"
  local qdir qprofile qshell
  printf -v qdir '%q' "$dir"
  printf -v qprofile '%q' "$profile"
  printf -v qshell '%q' "$shell_path"
  printf 'cd %s && (swop codex -- -p %s || true) && exec %s -l' "$qdir" "$qprofile" "$qshell"
}

repo_label_for() {
  local dir="$1"
  if git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    basename "$(git -C "$dir" rev-parse --show-toplevel)"
    return 0
  fi
  basename "$dir"
}

spawn_new_container() {
  local profile="$1"
  local dir="$2"
  local shell_path="$3"
  local reuse_existing_window="$4"
  local cmd pane_id
  cmd="$(build_profile_command "$profile" "$dir" "$shell_path")"

  if [[ "$reuse_existing_window" == "true" && -n "${WEZTERM_PANE:-}" ]]; then
    pane_id="$(
      wezterm cli spawn \
        --cwd "$dir" \
        -- "$shell_path" -lc "$cmd"
    )"
  else
    pane_id="$(
      wezterm cli spawn \
        --new-window \
        --cwd "$dir" \
        -- "$shell_path" -lc "$cmd"
    )"
  fi

  printf "%s" "$pane_id"
}

split_from_pane() {
  local pane_id="$1"
  local direction="$2"
  local profile="$3"
  local dir="$4"
  local shell_path="$5"
  local cmd
  cmd="$(build_profile_command "$profile" "$dir" "$shell_path")"

  case "$direction" in
    right)
      wezterm cli split-pane \
        --pane-id "$pane_id" \
        --right \
        --percent 50 \
        --cwd "$dir" \
        -- "$shell_path" -lc "$cmd" >/dev/null
      ;;
    bottom)
      wezterm cli split-pane \
        --pane-id "$pane_id" \
        --bottom \
        --percent 50 \
        --cwd "$dir" \
        -- "$shell_path" -lc "$cmd" >/dev/null
      ;;
    *)
      die "Unsupported split direction: $direction"
      ;;
  esac
}

reuse_current_pane() {
  local pane_id="$1"
  local profile="$2"
  local dir="$3"
  local shell_path="$4"
  local cmd
  cmd="$(build_profile_command "$profile" "$dir" "$shell_path")"
  wezterm cli send-text --pane-id "$pane_id" --no-paste "$cmd"$'\n' >/dev/null
}

set_tab_title() {
  local pane_id="$1"
  local title="$2"
  wezterm cli set-tab-title --pane-id "$pane_id" "$title" >/dev/null 2>&1 || true
}

while [[ $# -gt 0 ]]; do
  if [[ "$1" =~ ^-[^-]{2,}$ ]]; then
    short_cluster="${1#-}"
    expanded=()
    for ((i=0; i<${#short_cluster}; i++)); do
      ch="${short_cluster:i:1}"
      case "$ch" in
        m)
          if (( i + 1 < ${#short_cluster} )); then
            expanded+=("-m" "${short_cluster:i+1}")
          else
            expanded+=("-m")
          fi
          break
          ;;
        *)
          expanded+=("-$ch")
          ;;
      esac
    done
    set -- "${expanded[@]}" "${@:2}"
    continue
  fi

  case "$1" in
    -w|--worktree) worktree_pick=true; shift ;;
    -W|--worktree-only) worktree_pick=true; worktree_only=true; shift ;;
    -m|--mode) mode="${2:-}"; shift 2 ;;
    -c) mode="codex"; shift ;;
    -t) mode="standard"; shift ;;
    -b) mode="both"; shift ;;
    -T|--this-terminal) this_terminal=true; open_terminal=false; shift ;;
    -R|--reuse-tab|--reuse-window) reuse_tab="true"; shift ;;
    -N|--new-tab) reuse_tab="false"; shift ;;
    -H|--here) use_here=true; shift ;;
    -S|--status) status=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *)
      if [[ "$1" == -* ]]; then
        die "Unknown option: $1"
      fi
      target_dir="$1"
      shift
      ;;
  esac
done

if [[ -z "$target_dir" ]]; then
  target_dir="$PWD"
fi

require_cmd git
require_cmd python3

target_dir="$(realpath_of "$target_dir")"

case "$mode" in
  both|codex|standard) ;;
  *) die "Invalid --mode: $mode (expected: both|codex|standard)" ;;
esac

if [[ "$worktree_pick" == "true" ]]; then
  target_dir="$(select_worktree_dir "$target_dir")"
  target_dir="$(realpath_of "$target_dir")"
fi

if [[ "$worktree_only" == "true" ]]; then
  if [[ ! -t 0 || ! -t 1 ]]; then
    die "--worktree-only requires a TTY"
  fi

  interactive_shell="${SHELL:-}"
  if [[ -z "${interactive_shell:-}" || ! -x "$interactive_shell" ]]; then
    interactive_shell="$(command -v bash)"
  fi

  cd "$target_dir"
  exec "$interactive_shell" -i
  exit 0
fi

anchor_dir="$(realpath_of "$(anchor_dir_for "$target_dir")")"

if [[ ! -d "$anchor_dir" ]]; then
  die "Directory does not exist: $anchor_dir"
fi

if [[ "$mode" == "both" && "$this_terminal" == "true" ]]; then
  die "--this-terminal requires --mode codex|standard (can't open both in one terminal)"
fi

if git -C "$anchor_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
  :
else
  if [[ "$use_here" != "true" && "$target_dir" == "$(realpath_of "$PWD")" ]]; then
    anchor_dir="$DEFAULT_DIR"
  fi
fi

if [[ ! -d "$anchor_dir" ]]; then
  die "Directory does not exist: $anchor_dir"
fi

if [[ "$reuse_tab" == "auto" ]]; then
  if inside_wezterm; then
    reuse_tab="true"
  else
    reuse_tab="false"
  fi
fi

if [[ "$status" == "true" ]]; then
  printf "target_dir=%s\n" "$target_dir"
  printf "anchor_dir=%s\n" "$anchor_dir"
  printf "mode=%s\n" "$mode"
  printf "this_terminal=%s\n" "$this_terminal"
  printf "reuse_tab=%s\n" "$reuse_tab"
  printf "open_terminal=%s\n" "$open_terminal"
  printf "terminal_app=%s\n" "wezterm"
  exit 0
fi

interactive_shell="${SHELL:-}"
if [[ -z "${interactive_shell:-}" || ! -x "$interactive_shell" ]]; then
  interactive_shell="$(command -v bash)"
fi

if [[ "$this_terminal" == "true" ]]; then
  require_cmd bash
  profile="$mode"
  bash -lc 'cd "$1" && (swop codex -- -p "$2" || true); exec "$3" -l' bash "$anchor_dir" "$profile" "$interactive_shell"
  exit 0
fi

require_cmd wezterm

title="$(repo_label_for "$anchor_dir")"

if [[ "$reuse_tab" == "true" ]]; then
  [[ -n "${WEZTERM_PANE:-}" ]] || die "--reuse-tab requires running inside WezTerm"

  case "$mode" in
    codex)
      reuse_current_pane "$WEZTERM_PANE" "codex" "$anchor_dir" "$interactive_shell"
      set_tab_title "$WEZTERM_PANE" "$title"
      ;;
    standard)
      reuse_current_pane "$WEZTERM_PANE" "standard" "$anchor_dir" "$interactive_shell"
      set_tab_title "$WEZTERM_PANE" "$title"
      ;;
    both)
      reuse_current_pane "$WEZTERM_PANE" "codex" "$anchor_dir" "$interactive_shell"
      split_from_pane "$WEZTERM_PANE" "right" "standard" "$anchor_dir" "$interactive_shell"
      set_tab_title "$WEZTERM_PANE" "$title"
      ;;
  esac
  exit 0
fi

case "$mode" in
  codex)
    pane_id="$(spawn_new_container "codex" "$anchor_dir" "$interactive_shell" "$(inside_wezterm && printf true || printf false)")"
    set_tab_title "$pane_id" "$title"
    ;;
  standard)
    pane_id="$(spawn_new_container "standard" "$anchor_dir" "$interactive_shell" "$(inside_wezterm && printf true || printf false)")"
    set_tab_title "$pane_id" "$title"
    ;;
  both)
    pane_id="$(spawn_new_container "codex" "$anchor_dir" "$interactive_shell" "$(inside_wezterm && printf true || printf false)")"
    split_from_pane "$pane_id" "right" "standard" "$anchor_dir" "$interactive_shell"
    set_tab_title "$pane_id" "$title"
    ;;
esac
